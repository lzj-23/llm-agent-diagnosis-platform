APP_NAME=llm-agent-diagnosis-platform
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Copy to backend/.env. Never commit real keys.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_BUDGET_CNY=10
INPUT_PRICE_CNY_PER_MILLION=0.8
OUTPUT_PRICE_CNY_PER_MILLION=2.7
RAG_BACKEND=lexical
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
WEB_API_KEY=
WORKER_COUNT=2

# 外部项目只读目录。默认留空，避免把个人机器路径写入仓库。
RAG_RESULT_ROOT=
BENCHMARK_RESULT_ROOT=

# Omit DATABASE_URL and REDIS_URL for SQLite/local mode.
# Compose sets both automatically. For a separately running local database:
# DATABASE_URL=postgresql+psycopg://diagnosis:diagnosis@127.0.0.1:55432/diagnosis
# REDIS_URL=redis://127.0.0.1:56379/0
